---
# Rules and the reason for each exception: docs/quality/static-analysis.md
Checks: >-
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-macro-parentheses,
  -performance-avoid-endl,
  -performance-enum-size

WarningsAsErrors: '*'
# LLVM regexes have no lookahead: vendored headers are excluded with a separate filter.
HeaderFilterRegex: '.*/core/src/.*'
ExcludeHeaderFilterRegex: '.*stb_image.*'
FormatStyle: file
